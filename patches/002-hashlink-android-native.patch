+#if defined(HL_ANDROID)
+# include <unwind.h>
+# include <dlfcn.h>
+typedef struct { void **stack; int count; int size; int skip; } hlc_android_stack;
+static _Unwind_Reason_Code hlc_android_unwind(struct _Unwind_Context *context, void *arg) {
+    hlc_android_stack *state = (hlc_android_stack *)arg;
+    uintptr_t ip = _Unwind_GetIP(context);
+    if (state->skip > 0) { state->skip--; return _URC_NO_REASON; }
+    if (ip && state->count < state->size) state->stack[state->count++] = (void *)ip;
+    return state->count == state->size ? _URC_END_OF_STACK : _URC_NO_REASON;
+}
