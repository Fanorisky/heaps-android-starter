--- /dev/null
+++ b/hashlink/libs/sdl/utf8_packet.h
@@ -0,0 +1,25 @@
+#ifndef HEAPS_UTF8_PACKET_H
+#define HEAPS_UTF8_PACKET_H
+#include <stddef.h>
+#include <stdint.h>
+/* Consume one Unicode scalar and preserve the little-endian packed UTF8
+ * representation decoded by hxd.Window. Malformed maximal subsequences yield
+ * the packed UTF8 replacement character; reads never exceed length. */
+static inline int heaps_utf8_next(const unsigned char *text, size_t length,
+ size_t *position, uint32_t *packed) {
+ size_t start=*position;
+ if(start>=length)return 0;
+ unsigned char lead=text[start];
+ if(lead<0x80){*packed=lead;*position=start+1;return 1;}
+ int width=lead>=0xc0&&lead<=0xdf?2:lead>=0xe0&&lead<=0xef?3:lead>=0xf0&&lead<=0xf7?4:1;
+ size_t end=start+1;
+ while(end<length && end<start+(size_t)width && (text[end]&0xc0)==0x80)end++;
+ uint32_t cp=lead&((1U<<(7-width))-1U);
+ for(size_t i=start+1;i<end;i++)cp=(cp<<6)|(text[i]&0x3f);
+ uint32_t min=width==2?0x80:width==3?0x800:0x10000;
+ int valid=width>1 && end==start+(size_t)width && cp>=min && cp<=0x10ffff && !(cp>=0xd800&&cp<=0xdfff);
+ *packed=0x00bdbfef;
+ if(valid){*packed=0;for(int i=0;i<width;i++)*packed|=(uint32_t)text[start+i]<<(i*8);}
+ *position=end;return 1;
+}
+#endif
