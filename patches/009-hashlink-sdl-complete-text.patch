+/* Keep the rest of an SDL commit ahead of later keyboard/window events. */
+static SDL_SpinLock heaps_text_lock;
+static SDL_TextInputEvent heaps_text_commit;
+static size_t heaps_text_position, heaps_text_length;
+
+void sdl_cancel_text_input(void) {
+ SDL_AtomicLock(&heaps_text_lock);
+ heaps_text_position = heaps_text_length = 0;
+ SDL_AtomicUnlock(&heaps_text_lock);
+ SDL_FlushEvents(SDL_TEXTEDITING, SDL_TEXTINPUT);
+ SDL_StopTextInput();
+}
+
+static bool heaps_text_next(event_data *event) {
+ uint32_t packed;
+ SDL_AtomicLock(&heaps_text_lock);
+ int found = heaps_utf8_next((unsigned char*)heaps_text_commit.text,
+  heaps_text_length, &heaps_text_position, &packed);
+ if (found) {
+  event->type = TextInput;
+  event->window = heaps_text_commit.windowID;
+  event->keyCode = (int)packed;
+ }
+ SDL_AtomicUnlock(&heaps_text_lock);
+ return found != 0;
+}
+
 static bool isGlOptionsSet = false;
 
