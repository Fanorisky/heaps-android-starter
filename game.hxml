-cp src
-cp src/game
-lib castle
-lib hscript
-lib deepnightLibs
-lib ldtk-haxe-api
-lib heaps-aseprite
-lib heaps
-lib hlsdl
-lib hlopenal
-lib heapsandroid
-cp tests/android
-D resourcesPath=res
-D useProcessTweenie
--macro include('ui')
--macro include('en')
-main Boot
-D android
-D heapsandroid_audio_hooks
-D windowSize=360x640
-D hl-ver=1.15.0
-D no-compilation
-dce full
-hl build/hlc/game.c
